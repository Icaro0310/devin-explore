{
  "name": "devin-graph",
  "version": "0.1.0",
  "description": "Knowledge graph over Devin sessions — projects, files, tools and decisions as queryable nodes. Read-only queries.",
  "author": { "name": "Icaro0310" },
  "repository": "https://github.com/Icaro0310/devin-explore",
  "license": "MIT",
  "keywords": ["devin", "graph", "sessions.db"],
  "mcpServers": {
    "devin-graph": {
      "command": "uvx",
      "args": ["--from", "devin-graph[mcp]", "devin-graph-mcp"]
    }
  }
}
